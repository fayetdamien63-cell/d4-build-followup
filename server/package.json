{
  "name": "@d4/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts --serve-web",
    "start:lan": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts --serve-web --lan",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
